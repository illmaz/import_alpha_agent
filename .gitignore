__pycache__/
*.pyc
.venv/
.pytest_cache/
*.log.jsonl
.env
data/*.db
data/*.db-wal
data/*.db-shm
.env.backup.*

# --- secrets ----------------------------------------------------------
# .env holds live API keys. The bare name is not enough: a stray .env.local
# or .env.backup.1790094373 is just as dangerous, and one of those did reach
# the index once (recovered before it was pushed — see DECISIONS.md).
.env
.env.*
!.env.example
*.backup
*.backup.*

# --- anything that can capture a key in passing ------------------------
# Logs, dumps and exports routinely contain environment contents.
*.log
*.dump
*.sql
*.sqlite
*.sqlite3

# Agent lane scratch space: per-goal workspaces, manifests, decision log.
data/work/

# Qwen Code's own session directory: background-shell transcripts, scratch
# captures, worktrees. Never part of the product.
.qwen/
