# Copy to .env and edit. Every value here is optional — with no .env at all the
# stack comes up on FakeLLM with no credentials and no network calls.
# .env is gitignored; never commit a real key.

# --- LLM ---------------------------------------------------------------
# fake (default, deterministic canned plans, no network) | anthropic | openai
LLM_PROVIDER=fake
# Required only when LLM_PROVIDER is anthropic or openai.
LLM_API_KEY=
# Defaults to claude-opus-5 for the anthropic provider.
LLM_MODEL=
# Required for LLM_PROVIDER=openai; no endpoint is hardcoded. Vendor- and
# region-specific (DashScope/Qwen among others).
LLM_BASE_URL=

# --- Orchestrator liveness ---------------------------------------------
# Seconds a dispatched step may stay pending before it counts as stalled.
STEP_TTL_SECONDS=120
# How often the stall ticker sweeps for overdue steps.
STALL_TICK_SECONDS=10

# --- Roles --------------------------------------------------------------
# Roles the planner may target. Trim this while a worker is down, e.g.
# ACTIVE_ROLES=product,landing. Empty/unset means all three.
ACTIVE_ROLES=product,engineering,landing
