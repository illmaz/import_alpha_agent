# Copy to .env and edit:  cp .env.example .env
#
# With no .env at all the stack runs on FakeLLM: deterministic canned plans,
# no network, no key, no spend. Everything below is optional until you want a
# real model. .env is gitignored — never commit a real key.

# ======================================================================
# LLM provider
# ======================================================================
# fake (default) | anthropic | openai
LLM_PROVIDER=fake

# Required when LLM_PROVIDER is anthropic or openai. Costs real money.
LLM_API_KEY=your-key-here

# --- LLM_PROVIDER=anthropic -------------------------------------------
# Defaults to claude-opus-5 (llm.DEFAULT_ANTHROPIC_MODEL) if unset.
# Current model ids, cheapest last:
#   claude-opus-5     most capable, the repo default
#   claude-sonnet-5   mid-tier
#   claude-haiku-4-5  cheapest and fastest — good for a first live run
# Use the exact id, with no date suffix appended.
LLM_MODEL=claude-haiku-4-5

# --- LLM_PROVIDER=openai (OpenAI-compatible endpoints) ----------------
# LLM_MODEL is REQUIRED for this provider — there is no default.
# LLM_BASE_URL is REQUIRED — no endpoint is hardcoded, because the
# OpenAI-compatible path covers several vendors whose URLs differ by region
# and guessing one would be inventing configuration.
#   OpenAI          https://api.openai.com/v1            (e.g. gpt-4o-mini)
#   Qwen/DashScope  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Together        https://api.together.xyz/v1
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# ======================================================================
# Orchestrator liveness
# ======================================================================
# Seconds a dispatched step may stay pending before it counts as stalled.
STEP_TTL_SECONDS=120
# How often the stall ticker sweeps for overdue steps.
STALL_TICK_SECONDS=10

# ======================================================================
# Report reaper
# ======================================================================
# How long a report may sit pending before it is failed as abandoned. Keep it
# comfortably above STEP_TTL_SECONDS, or a healthy-but-slow goal gets reaped
# while the lane is still working on it.
REPORT_STALE_AFTER_SECONDS=300
# How often the reaper sweeps.
REAP_INTERVAL_SECONDS=60

# ======================================================================
# Roles
# ======================================================================
# Roles the planner may target. Trim while a worker is down, e.g.
# ACTIVE_ROLES=product,landing. Empty/unset means all three.
ACTIVE_ROLES=product,engineering,landing

# ======================================================================
# Storage
# ======================================================================
# DELETE, not WAL: the SQLite file is bind-mounted and opened by several
# containers, and WAL's shared-memory coordination is unreliable across a
# macOS bind mount. Set WAL only on a real local filesystem.
SQLITE_JOURNAL_MODE=DELETE
